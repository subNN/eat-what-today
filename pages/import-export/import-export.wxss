/* pages/import-export/import-export.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 操作区域 */
.action-section {
  margin-bottom: 20rpx;
}

/* 卡片区块 */
.section-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 按钮组 */
.button-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 操作按钮 */
.action-btn {
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  width: 100%;
  box-sizing: border-box;
  background-color: #07c160;
  color: white;
}

.action-btn.secondary {
  background-color: white;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.action-btn:active {
  opacity: 0.8;
}

/* JSON格式示例 */
.format-example {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.json-example {
  margin-top: 16rpx;
}

.json-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.json-code {
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}

.json-code text {
  font-size: 22rpx;
  color: #333;
  white-space: pre-wrap;
  word-break: break-all;
  font-family: monospace;
  line-height: 1.6;
}

.json-note {
  background-color: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.json-note text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}