/* pages/import-export/import-export.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 操作区域 */
.action-section {
  margin-bottom: 20rpx;
}

/* 卡片区块 */
.section-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 下拉表单样式 */
.menu-dropdown {
  margin-bottom: 24rpx;
}

.dropdown-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.dropdown-header:active {
  background-color: #f0f0f0;
}

.dropdown-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.dropdown-icon {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.3s ease;
}

.dropdown-icon.rotated {
  transform: rotate(90deg);
}

.dropdown-content {
  background-color: white;
  border-radius: 12rpx;
  padding: 0;
  margin-top: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 勾选框组 */
.checkbox-group {
  padding: 0;
}

/* 勾选项样式 */
.checkbox-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid #f5f5f5;
  cursor: pointer;
  transition: all 0.2s ease;
}

.checkbox-item:last-child {
  border-bottom: none;
}

/* 选中时高亮 */
.checkbox-item.active {
  background: rgba(5, 193, 96, 0.08);
}

/* 勾选框样式 */
.check-box {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #999;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  transition: all 0.2s ease;
  background-color: white;
  flex-shrink: 0;
}

/* 勾选后样式 */
.check-box.checked {
  background: #07c160;
  border-color: #07c160;
}

.check-box text {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 菜单项信息 */
.menu-item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.menu-item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.menu-item-count {
  font-size: 24rpx;
  color: #999;
}

/* 按钮组 */
.button-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 操作按钮 */
.action-btn {
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  width: 100%;
  box-sizing: border-box;
  background-color: #07c160;
  color: white;
}

.action-btn.secondary {
  background-color: white;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.action-btn:active {
  opacity: 0.8;
}

.action-btn[disabled] {
  opacity: 0.5;
  background-color: #d9d9d9;
  color: white;
  border-color: #d9d9d9;
}

/* JSON格式示例 */
.format-example {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.json-example {
  margin-top: 16rpx;
}

.json-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.json-code {
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}

.json-code text {
  font-size: 22rpx;
  color: #333;
  white-space: pre-wrap;
  word-break: break-all;
  font-family: monospace;
  line-height: 1.6;
}

.json-note {
  background-color: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.json-note text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}