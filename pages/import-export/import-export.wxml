<!--pages/import-export/import-export.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="header-title">导入导出</text>
    <text class="header-subtitle">管理你的菜单数据</text>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-section">
    <!-- 导出选项 -->
    <view class="section-card">
      <text class="section-title">导出菜单</text>
      
      <!-- 下拉表单 -->
      <view class="menu-dropdown">
        <!-- 下拉表单头部 -->
        <view class="dropdown-header" bindtap="toggleMenuSelection">
          <text class="dropdown-title">{{selectedMenuName}}</text>
          <image src="/icon/icon-right.png" class="dropdown-icon {{menuSelectionExpanded ? 'rotated' : ''}}"></image>
        </view>
        
        <!-- 下拉菜单内容 -->
        <view wx:if="{{menuSelectionExpanded}}" class="dropdown-content">
          <!-- 全选选项 -->
          <view 
            class="checkbox-item {{allSelected ? 'active' : ''}}" 
            bindtap="handleSelectAllClick"
          >
            <view class="check-box {{allSelected ? 'checked' : ''}}">
              <text wx:if="{{allSelected}}">✔</text>
            </view>
            <text class="label">全选</text>
          </view>
          
          <!-- 菜单列表 -->
          <view class="checkbox-group">
            <view 
              wx:for="{{menuList}}"  
              wx:key="index" 
              class="checkbox-item {{item.checked ? 'active' : ''}}" 
              bindtap="toggleMenuItem" 
              data-index="{{index}}"
            >
              <view class="check-box {{item.checked ? 'checked' : ''}}">
                <text wx:if="{{item.checked}}">✔</text>
              </view>
              <view class="menu-item-info">
                <text class="menu-item-name">{{item.name}}</text>
                <text class="menu-item-count">{{item.dishCount}}道菜品</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 导出按钮 -->
      <view class="button-group">
        <button 
          bindtap="exportToFile" 
          class="action-btn" 
          disabled="{{selectedCount === 0}}"
        >导出到文件</button>
        <button 
          bindtap="exportToClipboard" 
          class="action-btn secondary" 
          disabled="{{selectedCount === 0}}"
        >复制到剪切板</button>
      </view>
    </view>

    <!-- 导入选项 -->
    <view class="section-card">
      <text class="section-title">导入菜单</text>
      <view class="button-group">
        <button bindtap="importFromFile" class="action-btn">从文件导入</button>
        <button bindtap="importFromClipboard" class="action-btn secondary">从剪切板导入</button>
      </view>
    </view>
  </view>

  <!-- JSON格式示例 -->
  <view class="format-example">
    <view class="section-header">
      <text class="section-title">支持的JSON格式示例</text>
    </view>
    <view class="json-example">
      <text class="json-label">单个菜单格式：</text>
      <view class="json-code">
        <text>{{singleMenuExample}}</text>
      </view>
      
      <text class="json-label">多个菜单格式：</text>
      <view class="json-code">
        <text>{{multipleMenuExample}}</text>
      </view>
      
      <text class="json-label">说明：</text>
      <view class="json-note">
        <text>1. name: 菜单名称（必填）</text>
        <text>2. dishes: 菜品数组</text>
        <text>3. dish.name: 菜品名称（必填）</text>
        <text>4. dish.price: 单价（可选，为null表示无单价）</text>
        <text>5. dish.unit: 单位（必填）</text>
      </view>
    </view>
  </view>
</view>