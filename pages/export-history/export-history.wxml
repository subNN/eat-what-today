<!--pages/export-history/export-history.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="header-title">导出选菜历史</text>
    <text class="header-subtitle">选择要导出的历史记录</text>
  </view>

  <!-- 日期筛选 -->
  <view class="date-filter">
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange" class="date-picker">
      <view class="date-picker-content">
        <text class="date-text">{{selectedDateText}}</text>
        <text class="date-icon">▼</text>
      </view>
    </picker>
    <view class="date-actions">
      <button bindtap="clearDateFilter" class="clear-filter-btn" wx:if="{{selectedDate}}">清除筛选</button>
    </view>
  </view>

  <!-- 全选区域 -->
  <view class="select-all-bar" wx:if="{{totalCount > 0}}">
    <view 
      class="checkbox-item {{allSelected ? 'active' : ''}}" 
      bindtap="handleSelectAllClick"
    >
      <view class="check-box {{allSelected ? 'checked' : ''}}">
        <text wx:if="{{allSelected}}">✔</text>
      </view>
      <text class="label">全选 ({{totalCount}}条)</text>
    </view>
  </view>

  <!-- 按年月分组的历史记录 -->
  <view class="history-grouped-list">
    <view wx:for="{{groupedHistory}}" wx:key="yearMonth" class="history-month-group">
      <!-- 年月分组头部 -->
      <view class="month-header" bindtap="toggleMonthExpand" data-key="{{item.yearMonth}}">
        <text class="month-title">{{item.yearMonth}}</text>
        <text class="month-count">{{item.records.length}}条</text>
        <text class="expand-icon {{item.expanded ? 'rotated' : ''}}">▼</text>
      </view>
      
      <!-- 月内历史记录 -->
      <view wx:if="{{item.expanded}}" class="month-records">
        <view 
          wx:for="{{item.records}}"  
          wx:key="time" 
          class="history-record-item checkbox-item {{item.checked ? 'active' : ''}}" 
          bindtap="toggleHistoryItem" 
          data-yearmonth="{{item.yearMonth}}"
          data-time="{{item.time}}"
        >
          <view class="check-box {{item.checked ? 'checked' : ''}}">
            <text wx:if="{{item.checked}}">✔</text>
          </view>
          <view class="record-info">
            <text class="record-meal">{{item.meal}}</text>
            <text class="record-time">{{item.time}}</text>
            <text class="record-count">{{item.dishes.length}}道菜品</text>
          </view>
          <view class="record-total">
            <text class="total-price">{{item.totalPrice === '大于' ? '大于¥' + item.totalPriceAmount : '¥' + item.totalPrice}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{groupedHistory.length === 0}}" class="empty-history">
    <text>暂无选菜历史</text>
  </view>

  <!-- 导出按钮组 -->
  <view wx:if="{{selectedCount > 0}}" class="export-buttons">
    <button bindtap="exportToFile" class="export-btn">导出到文件(.txt)</button>
    <button bindtap="exportToClipboard" class="export-btn secondary">复制到剪切板</button>
  </view>
</view>