/* menu.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 操作按钮区域 */
.action-bar {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  outline: none;
}

.action-btn.create {
  background-color: #07c160;
  color: white;
}

.action-btn.import-export {
  background-color: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.action-btn.edit {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #e0e0e0;
}

/* 批量操作区域 */
.batch-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.batch-btn {
  flex: 1;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  outline: none;
  background-color: #f5f5f5;
  color: #333;
}

.batch-btn.delete {
  background-color: #ff4d4f;
  color: white;
}

/* 菜单管理区域 */
.menu-management {
  margin-bottom: 24rpx;
}

/* 菜单头部 */
.menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

/* 清空菜单按钮 */
.clear-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background-color: rgba(255, 77, 79, 0.8);
  color: white;
  border: 1rpx solid rgba(255, 77, 79, 0.3);
  outline: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.clear-icon {
  width: 24rpx;
  height: 24rpx;
}

.clear-text {
  font-size: 24rpx;
  color: white;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 菜单项 */
.menu-item {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
}

.menu-item.selected {
  background-color: #f0f9f0;
  border: 2rpx solid #07c160;
}

.menu-item.current {
  border: 2rpx solid #07c160;
}

/* 选择框 */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e0e0e0;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: white;
}

.checkbox.checked {
  background-color: #07c160;
  border-color: #07c160;
  color: white;
}

/* 菜单内容 */
.menu-content {
  flex: 1;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
  display: block;
}

.dish-count {
  font-size: 24rpx;
  color: #666;
}

/* 菜单操作 */
.menu-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 编辑按钮 */
.edit-btn {
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #e0e0e0;
  outline: none;
}

/* 删除菜单按钮 */
.delete-btn {
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background-color: #f5f5f5;
  color: #ff4d4f;
  border: 1rpx solid #e0e0e0;
  outline: none;
}

/* 当前菜单区域 */
.current-menu {
  background-color: white;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  width: 100%;
  box-sizing: border-box;
}

/* 当前菜单头部 */
.current-menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.current-menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 编辑菜单按钮 */
.edit-menu-btn {
  font-size: 24rpx;
  color: #07c160;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #07c160;
  background-color: white;
  outline: none;
}

/* 菜品列表 */
.dish-list {
  margin-bottom: 20rpx;
}

/* 菜品项 */
.dish-item {
  padding: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s ease;
  border-radius: 8rpx;
  margin: 4rpx 0;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
  display: block;
}

.dish-price {
  font-size: 26rpx;
  color: #666;
}

.dish-unit {
  font-size: 26rpx;
  color: #666;
}

/* 删除菜品按钮 */
.delete-dish-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  padding: 0;
  background-color: #f5f5f5;
  color: #999;
  border: none;
  flex-shrink: 0;
}

/* 空菜品状态 */
.empty-dishes {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  margin: 20rpx 0;
}

/* 无菜单提示 */
.no-menu-selected {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 弹窗样式 */
.dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.dialog-content {
  background-color: white;
  border-radius: 20rpx;
  width: 80%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  animation: dialogIn 0.3s ease;
}

@keyframes dialogIn {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dialog-header text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  font-size: 36rpx;
  color: #999;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: none;
}

.dialog-body {
  padding: 24rpx;
}

.confirm-btn {
  background-color: #07c160;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 16rpx;
  border: none;
  outline: none;
  width: 100%;
  box-sizing: border-box;
}