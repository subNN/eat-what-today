/* pages/edit-menu/edit-menu.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标签样式 */
.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

/* 输入框 */
.input {
  width: 100%;
  padding: 24rpx 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  outline: none;
  box-sizing: border-box;
  background-color: white;
  min-height: 80rpx;
  line-height: 36rpx;
}

.input:focus {
  border-color: #07c160;
}

/* 菜单名称区域 */
.menu-name-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 菜品管理区域 */
.dish-management {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 区域头部 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.dish-count {
  font-size: 22rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 添加菜品表单 */
.add-dish-form {
  background-color: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

/* 单位选择器 */
.unit-selector {
  margin-bottom: 16rpx;
}

.selector-container {
  margin-bottom: 16rpx;
}

.picker {
  width: 100%;
  padding: 24rpx 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  background-color: white;
  min-height: 80rpx;
  line-height: 36rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* 添加按钮 */
.add-btn {
  background-color: #07c160;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  outline: none;
  width: 100%;
  margin-top: 12rpx;
  box-sizing: border-box;
  min-height: 80rpx;
}

/* 菜品列表 */
.dish-list {
  margin-bottom: 20rpx;
}

/* 菜品项 */
.dish-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s ease;
  border-radius: 8rpx;
  margin: 4rpx 0;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
  display: block;
}

.dish-price {
  font-size: 24rpx;
  color: #666;
}

.dish-unit {
  font-size: 24rpx;
  color: #666;
}

/* 删除按钮 */
.delete-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  padding: 0;
  background-color: #f5f5f5;
  color: #999;
  border: none;
  flex-shrink: 0;
}

/* 空菜品状态 */
.empty-dishes {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  margin: 20rpx 0;
}

/* 操作按钮容器 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 操作按钮 */
.action-btn {
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
}

.action-btn.primary {
  background-color: #07c160;
  color: white;
}