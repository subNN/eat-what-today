<!--history.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="header-title">选菜历史</text>
    <text class="header-subtitle">查看以往的选菜记录</text>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-bar">
    <button bindtap="refreshHistory" class="action-btn refresh">刷新</button>
    <button bindtap="toggleEditMode" class="action-btn edit">{{isEditMode ? '取消' : '删除'}}</button>
  </view>

  <!-- 批量操作区域 -->
  <view wx:if="{{isEditMode}}" class="batch-actions">
    <button bindtap="clearAllHistory" class="batch-btn delete">清空历史</button>
  </view>

  <view class="history-list">
    <view wx:for="{{historyMenus}}" wx:key="index" class="history-item {{selectedItems.indexOf(index) > -1 ? 'selected' : ''}}" bindtap="toggleSelectItem" data-index="{{index}}">
      <!-- 选中标记 -->
      <view wx:if="{{selectedItems.indexOf(index) > -1}}" class="selected-mark">✓</view>
      
      <view class="history-content">
        <view class="history-header">
          <text class="history-time">{{item.time}}</text>
          <text class="history-meal">{{item.meal}}</text>
        </view>
        <view class="history-dishes">
          <view wx:for="{{item.dishes}}" wx:key="dishIndex" class="history-dish">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-price" wx:if="{{item.price}}">¥{{item.price}} × {{item.quantity}}</text>
            <text class="dish-price" wx:else>无 × {{item.quantity}}</text>
          </view>
        </view>
        <view class="history-total">
          <text>总价：{{item.totalPrice}}</text>
        </view>
      </view>
      
      <!-- 单独删除按钮 -->
      <button wx:if="{{!isEditMode}}" bindtap="deleteSingleHistory" data-index="{{index}}" class="single-delete-btn">×</button>
    </view>
  </view>

  <view wx:if="{{historyMenus.length === 0}}" class="empty">
    <text>暂无选菜历史</text>
  </view>
</view>

<!-- 刷新按钮 -->
<button wx:if="{{!isEditMode}}" bindtap="refreshHistory" class="refresh-btn">↻</button>