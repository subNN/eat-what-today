<!--pages/history/history.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="header-title">选菜历史</text>
    <text class="header-subtitle">查看以往的选菜记录</text>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-bar">
    <button bindtap="refreshHistory" class="action-btn refresh">刷新</button>
    <button bindtap="goToExportHistory" class="action-btn export">
      <text>导出历史</text>
    </button>
    <button bindtap="clearAllHistory" class="action-btn clear">
      <image src="/icon/icon-删除.png" class="clear-icon"></image>
      <text class="clear-text">清空</text>
    </button>
  </view>

  <!-- 日期筛选 -->
  <view class="date-filter">
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange" class="date-picker">
      <view class="date-picker-content">
        <text class="date-text">{{selectedDateText}}</text>
        <text class="date-icon">▼</text>
      </view>
    </picker>
    <view class="date-actions">
      <button bindtap="clearDateFilter" class="clear-filter-btn" wx:if="{{selectedDate}}">清除筛选</button>
    </view>
  </view>

  <!-- 按年月分组的历史记录 -->
  <view class="history-grouped-list">
    <view wx:for="{{groupedHistory}}" wx:key="yearMonth" class="history-month-group">
      <!-- 年月分组头部 -->
      <view class="month-header" bindtap="toggleMonthExpand" data-key="{{item.yearMonth}}">
        <text class="month-title">{{item.yearMonth}}</text>
        <text class="month-count">{{item.records.length}}条</text>
        <text class="expand-icon {{item.expanded ? 'rotated' : ''}}">▼</text>
      </view>
      
      <!-- 月内历史记录 -->
      <view wx:if="{{item.expanded}}" class="month-records">
        <view wx:for="{{item.records}}" wx:key="time" class="history-item">
          <view class="history-item-header">
            <view class="history-info">
              <text class="history-time">{{item.time}}</text>
              <text class="history-meal">{{item.meal}}</text>
            </view>
          </view>
          <view class="history-dishes">
            <view wx:for="{{item.dishes}}" wx:key="dishIndex" class="dish-item">
              <text class="dish-name">{{item.name}}</text>
              <text class="dish-info">
                {{item.price ? '¥' + item.price : '无'}} × {{item.quantity}}
              </text>
            </view>
          </view>
          <view class="history-footer">
            <text class="total-price">
              总价: {{item.totalPrice === '大于' ? '大于¥' + item.totalPriceAmount : '¥' + item.totalPrice}}
            </text>
            <button bindtap="deleteHistory" data-yearmonth="{{item.yearMonth}}" data-time="{{item.time}}" class="delete-btn">删除</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{groupedHistory.length === 0}}" class="empty-history">
    <text>暂无选菜历史</text>
  </view>
</view>