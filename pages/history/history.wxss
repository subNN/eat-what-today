/* pages/history/history.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 操作按钮区域 */
.action-bar {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  outline: none;
}

.action-btn.refresh {
  background-color: #07c160;
  color: white;
}

.action-btn.export {
  background-color: #07c160;
  color: white;
}

.action-btn.clear {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background-color: rgba(255, 77, 79, 0.8);
  color: white;
  border: 1rpx solid rgba(255, 77, 79, 0.3);
  white-space: nowrap;
  flex-shrink: 0;
}

.clear-icon {
  width: 24rpx;
  height: 24rpx;
}

.clear-text {
  font-size: 24rpx;
  color: white;
}

/* 日期筛选 */
.date-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: white;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.date-picker {
  flex: 1;
}

.date-picker-content {
  display: flex;
  align-items: center;
}

.date-text {
  font-size: 28rpx;
  color: #333;
  margin-right: 12rpx;
}

.date-icon {
  font-size: 20rpx;
  color: #999;
}

.date-actions {
  flex-shrink: 0;
  margin-left: 20rpx;
}

.clear-filter-btn {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  background-color: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 8rpx;
}

/* 按年月分组的历史记录 */
.history-grouped-list {
  margin-bottom: 24rpx;
}

/* 月份分组 */
.history-month-group {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 月份头部 */
.month-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f8f8;
  cursor: pointer;
  transition: all 0.2s ease;
}

.month-header:active {
  background-color: #f0f0f0;
}

.month-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.month-count {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.expand-icon {
  font-size: 20rpx;
  color: #999;
  transition: transform 0.3s ease;
}

.expand-icon.rotated {
  transform: rotate(180deg);
}

/* 月内记录 */
.month-records {
  border-top: 1rpx solid #f0f0f0;
}

/* 历史记录项 */
.history-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

/* 历史记录项头部 */
.history-item-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.history-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.history-time {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-meal {
  font-size: 20rpx;
  color: white;
  background-color: #07c160;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* 历史记录菜品 */
.history-dishes {
  margin-bottom: 16rpx;
}

.dish-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.dish-info {
  font-size: 24rpx;
  color: #666;
}

/* 历史记录底部 */
.history-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.total-price {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

/* 删除按钮 */
.delete-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background-color: #f5f5f5;
  color: #ff4d4f;
  border: 1rpx solid #e0e0e0;
  outline: none;
  flex-shrink: 0;
  margin-left: auto;
}

/* 空历史状态 */
.empty-history {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}