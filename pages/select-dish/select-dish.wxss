/* pages/select-dish/select-dish.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 菜单信息 */
.menu-info {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.dish-count {
  font-size: 24rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

/* 菜品列表 */
.dish-list {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 菜品项 */
.dish-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-item:active {
  background-color: #f0f9f0;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
  display: block;
}

.dish-price {
  font-size: 26rpx;
  color: #666;
}

.dish-unit {
  font-size: 26rpx;
  color: #666;
}

/* 勾选框 */
.dish-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e0e0e0;
  margin-left: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.dish-checkbox.checked {
  background-color: #07c160;
  border-color: #07c160;
}

.checkmark {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

/* 空菜品状态 */
.empty-dishes {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  margin: 20rpx 0;
}

/* 已选菜品区域 */
.selected-dishes {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 区域头部 */
.section-header {
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 已选菜品项 */
.selected-dish {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.selected-dish:last-child {
  border-bottom: none;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 4rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  padding: 0;
  background-color: white;
  border: 1rpx solid #e0e0e0;
}

.quantity {
  margin: 0 16rpx;
  font-size: 28rpx;
  min-width: 32rpx;
  text-align: center;
  color: #333;
}

/* 总价区域 */
.total-price {
  text-align: right;
  font-size: 32rpx;
  font-weight: 600;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  color: #333;
}

/* 操作按钮容器 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 操作按钮 */
.action-btn {
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  width: 100%;
  box-sizing: border-box;
}

.action-btn.primary {
  background-color: #07c160;
  color: white;
}

.action-btn.secondary {
  background-color: white;
  color: #333;
  border: 1rpx solid #e0e0e0;
}