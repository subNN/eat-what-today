<!--pages/select-dish/select-dish.wxml-->
<view class="container">
  <!-- 菜单信息 -->
  <view class="menu-info">
    <text class="menu-name">{{menu.name}}</text>
    <text class="dish-count">{{menu.dishes ? menu.dishes.length : 0}} 道菜品</text>
  </view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <view wx:for="{{menu.dishes}}" wx:key="index" class="dish-item" bindtap="toggleDishSelection" data-index="{{index}}">
      <view class="dish-info">
        <text class="dish-name">{{item.name}}</text>
        <text class="dish-price" wx:if="{{item.price}}">¥{{item.price}}/{{item.unit}}</text>
        <text class="dish-unit" wx:else>{{item.unit}}</text>
      </view>
    </view>
    <view wx:if="{{!menu.dishes || menu.dishes.length === 0}}" class="empty-dishes">
      <text>该菜单暂无菜品</text>
    </view>
  </view>

  <!-- 已选菜品 -->
  <view wx:if="{{selectedDishes.length > 0}}" class="selected-dishes">
    <view class="section-header">
      <text class="section-title">已选菜品</text>
    </view>
    <view wx:for="{{selectedDishes}}" wx:key="index" class="selected-dish">
      <view class="dish-info">
        <text class="dish-name">{{item.name}}</text>
        <text class="dish-price" wx:if="{{item.price}}">¥{{item.price}}/{{item.unit}}</text>
        <text class="dish-unit" wx:else>{{item.unit}}</text>
      </view>
      <view class="quantity-control">
        <button bindtap="decreaseQuantity" data-index="{{index}}" class="quantity-btn">-</button>
        <text class="quantity">{{item.quantity}}</text>
        <button bindtap="increaseQuantity" data-index="{{index}}" class="quantity-btn">+</button>
      </view>
    </view>
    <view class="total-price">
      <text>总价：{{totalPrice}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button bindtap="randomDish" class="action-btn secondary">今天吃什么</button>
    <button bindtap="saveSelection" class="action-btn primary">确定选择</button>
  </view>
</view>