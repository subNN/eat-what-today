/* index.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 餐别选择区域 */
.meal-selector {
  margin-bottom: 24rpx;
}

/* 菜单选择区域 */
.menu-selector {
  margin-bottom: 24rpx;
}

/* 标签样式 */
.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

/* 餐别按钮容器 */
.meal-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

/* 餐别按钮 */
.meal-btn {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background-color: white;
  border: 1rpx solid #e0e0e0;
  transition: all 0.3s ease;
  flex: 1;
  min-width: 100rpx;
  text-align: center;
  color: #333;
}

.meal-btn.active {
  background-color: #07c160;
  color: white;
  border-color: #07c160;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 菜单项 */
.menu-item {
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s ease;
}

/* 菜单头部 */
.menu-header {
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: all 0.3s ease;
}

.menu-header:active {
  background-color: #f0f9f0;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.dish-count {
  font-size: 24rpx;
  color: #666;
  margin-right: 12rpx;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.expand-icon {
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

/* 菜单菜品列表 */
.menu-dishes {
  padding: 0 20rpx 20rpx;
  background-color: #f8f8f8;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 菜单菜品项 */
.menu-dish {
  padding: 12rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #e0e0e0;
}

.menu-dish:last-child {
  border-bottom: none;
}

.menu-dish .dish-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.menu-dish .dish-price {
  font-size: 24rpx;
  color: #666;
}

.menu-dish .dish-unit {
  font-size: 24rpx;
  color: #666;
}

/* 空菜品状态 */
.empty-dishes {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* 使用菜单按钮 */
.use-menu-btn {
  width: 90%;
  margin: 16rpx 5%;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: #07c160;
  color: white;
  border: none;
  outline: none;
  text-align: center;
}

/* 随机选择按钮 */
.action-btn {
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.action-btn.primary {
  background-color: #07c160;
  color: white;
}

/* 无菜单提示 */
.no-menu-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin: 20rpx 0;
}

/* 刷新按钮 */
.refresh-btn {
  position: fixed;
  bottom: 100rpx;
  right: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #07c160;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  z-index: 99;
  transition: all 0.3s ease;
  border: none;
  font-size: 36rpx;
}