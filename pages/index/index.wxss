/* index.wxss */
/* 页面容器 */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 餐别选择区域 */
.meal-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.meal-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.meal-btn {
  flex: 1 1 calc(25% - 12rpx);
  min-width: 120rpx;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  background-color: white;
  color: #333;
  border: 1rpx solid #e0e0e0;
  outline: none;
  transition: all 0.3s ease;
}

.meal-btn.active {
  background-color: #07c160;
  color: white;
  border-color: #07c160;
}

/* 菜单选择区域 */
.menu-section {
  margin-bottom: 32rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-item {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  overflow: hidden;
}

/* 菜单头部 */
.menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  margin-bottom: 16rpx;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.menu-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dish-count {
  font-size: 24rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 下拉图标 */
.dropdown-icon {
  width: 24rpx;
  height: 24rpx;
  transition: transform 0.3s ease;
}

/* 旋转动画 */
.dropdown-icon.rotated {
  transform: rotate(90deg);
}

/* 菜品列表 */
.dish-list {
  margin: 0 -20rpx 16rpx -20rpx;
  padding: 0 20rpx 16rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dish-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.dish-price {
  font-size: 24rpx;
  color: #666;
}

.dish-unit {
  font-size: 24rpx;
  color: #666;
}

/* 使用按钮 */
.use-btn {
  background-color: #07c160;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  outline: none;
  transition: all 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}

/* 刷新按钮 */
.refresh-container {
  position: fixed;
  bottom: 32rpx;
  right: 32rpx;
  z-index: 999;
}

.refresh-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #07c160;
  color: white;
  border: none;
  outline: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.4);
  transition: all 0.3s ease;
}

.refresh-btn:active {
  transform: scale(0.95);
}

.refresh-icon {
  width: 40rpx;
  height: 40rpx;
  transition: transform 0.6s ease;
}

/* 旋转动画 */
.refresh-icon.rotating {
  animation: rotate 0.6s linear;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}