<!--index.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="header-title">今天吃什么</text>
    <text class="header-subtitle">选择你的美味佳肴</text>
  </view>

  <!-- 餐别选择区域 -->
  <view class="meal-section">
    <text class="section-title">选择餐别</text>
    <view class="meal-buttons">
      <button bindtap="selectMeal" data-meal="早餐" class="meal-btn {{selectedMeal === '早餐' ? 'active' : ''}}">早餐</button>
      <button bindtap="selectMeal" data-meal="午餐" class="meal-btn {{selectedMeal === '午餐' ? 'active' : ''}}">午餐</button>
      <button bindtap="selectMeal" data-meal="晚餐" class="meal-btn {{selectedMeal === '晚餐' ? 'active' : ''}}">晚餐</button>
      <button bindtap="selectMeal" data-meal="加餐" class="meal-btn {{selectedMeal === '加餐' ? 'active' : ''}}">加餐</button>
    </view>
  </view>

  <!-- 菜单选择区域 -->
  <view class="menu-section">
    <text class="section-title">选择菜单</text>
    <view class="menu-list">
      <view wx:for="{{menus}}" wx:key="index" class="menu-item">
        <!-- 菜单头部 -->
        <view class="menu-header" bindtap="toggleMenu" data-index="{{index}}">
          <text class="menu-name">{{item.name}}</text>
          <view class="menu-info">
            <text class="dish-count">{{item.dishes.length}} 道菜品</text>
            <image src="/icon/icon-right.png" class="dropdown-icon {{expandedMenuIndex === index ? 'rotated' : ''}}"></image>
          </view>
        </view>
        
        <!-- 菜品列表（默认隐藏） -->
        <view wx:if="{{expandedMenuIndex === index}}" class="dish-list">
          <view wx:for="{{item.dishes}}" wx:key="dishIndex" class="dish-item">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-price" wx:if="{{item.price}}">¥{{item.price}}/{{item.unit}}</text>
            <text class="dish-unit" wx:else>{{item.unit}}</text>
          </view>
        </view>
        
        <!-- 使用按钮 -->
        <button bindtap="useMenu" data-index="{{index}}" class="use-btn">使用此菜单</button>
      </view>
    </view>
  </view>

  <!-- 刷新按钮 -->
  <view class="refresh-container">
    <button bindtap="handleRefresh" class="refresh-btn">
      <image src="/icon/刷新.png" mode="aspectFit" class="refresh-icon {{isRefreshing ? 'rotating' : ''}}"></image>
    </button>
  </view>
</view>