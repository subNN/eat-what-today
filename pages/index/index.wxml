<!--index.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="header-title">今天吃什么</text>
    <text class="header-subtitle">选择你的美味佳肴</text>
  </view>

  <!-- 餐别选择区域 -->
  <view class="meal-selector">
    <text class="label">选择餐别</text>
    <view class="meal-buttons">
      <button wx:for="{{mealTypes}}" wx:key="index" bindtap="selectMeal" data-meal="{{item}}" class="meal-btn {{selectedMeal === item ? 'active' : ''}}">{{item}}</button>
    </view>
  </view>

  <!-- 菜单选择区域 -->
  <view class="menu-selector">
    <text class="label">选择菜单</text>
    <view class="menu-list">
      <view wx:for="{{menus}}" wx:key="index" class="menu-item">
        <view class="menu-header" bindtap="toggleMenuExpand" data-index="{{index}}">
          <text class="menu-name">{{item.name}}</text>
          <text class="dish-count">{{item.dishes ? item.dishes.length : 0}} 道菜品</text>
          <text class="expand-icon">{{expandedMenuIndex === index ? '▼' : '▶'}}</text>
        </view>
        
        <!-- 展开的菜品列表 -->
        <view wx:if="{{expandedMenuIndex === index}}" class="menu-dishes">
          <view wx:for="{{item.dishes}}" wx:key="dishIndex" class="menu-dish">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-price" wx:if="{{item.price}}">¥{{item.price}}/{{item.unit}}</text>
            <text class="dish-unit" wx:else>{{item.unit}}</text>
          </view>
          <view wx:if="{{!item.dishes || item.dishes.length === 0}}" class="empty-dishes">
            <text>暂无菜品</text>
          </view>
        </view>
        
        <!-- 使用按钮 -->
        <button bindtap="useMenu" data-index="{{index}}" class="use-menu-btn">使用此菜单</button>
      </view>
      <view wx:if="{{menus.length === 0}}" class="no-menu-tip">
        <text>请先在我的菜单中创建菜单</text>
      </view>
    </view>
  </view>

  <!-- 刷新按钮 -->
  <button bindtap="refreshDishes" class="refresh-btn">↻</button>
</view>